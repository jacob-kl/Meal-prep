  "jakeLunch": {
    "name": "Turkish-Style Lentil + Chicken Bowl",
    "note": "Make the full batch below, then divide into 5 equal containers. Grab one each day Mon\u2013Fri. Reheat 2 min \u2014 add a splash of water to the lentils first.",
    "macros": {
      "cal": 650,
      "protein": 68,
      "carbs": 42,
      "fat": 18,
      "fiber": 16
    },
    "ingredients": [
      "2.6 lbs boneless chicken thighs",
      "2 cups dry red lentils (makes enough for 5 \u2014 don't reduce)",
      "2 cans (15 oz each) black beans, drained",
      "2 large zucchini, diced",
      "10 oz / about 8 big handfuls fresh spinach",
      "4 garlic cloves",
      "2 tbsp olive oil",
      "2 tsp cumin, 2 tsp smoked paprika, 1 tsp turmeric",
      "Salt, pepper, lemon juice",
      "5 tbsp Greek yogurt \u2014 1 per container (optional)"
    ],
    "steps": [
      "Season ALL the chicken with cumin, paprika, salt + pepper. Bake at 400F / 200C for 25 min. Cool and shred the whole batch \u2014 this is the protein for all 5 containers.",
      "Rinse ALL the lentils. Simmer in 3.5 cups (900ml) water with turmeric + crushed garlic for 15 min until soft. They thicken as they cool \u2014 that's normal. This is the base for all 5.",
      "In a large pan, saute ALL the zucchini in olive oil 5 min. Add ALL the black beans, warm through. Add ALL the spinach, toss until wilted.",
      "Now divide: split everything evenly across 5 containers \u2014 lentils on the bottom, the veggie/bean mix in the middle, shredded chicken on top.",
      "Squeeze lemon over each container. Pack Greek yogurt separately if using \u2014 mix in right before eating. Done for the week."
    ]
  },
